# ---- Gemini Live (the ONLY model token you need) ----
# Paste your Gemini API key here (the same token your model uses).
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
LIVE_MODEL=gemini-3.1-flash-live-preview

# ---- Postgres (matches docker-compose.yml) ----
DATABASE_URL=postgresql://dental:dental@localhost:5432/dental

# ---- Mock Dentally PMS (swap to the real Dentally base URL after you're hired) ----
PMS_BASE_URL=http://localhost:8000/pms/v1

# ---- Which clinic config to load ----
CLINIC_CONFIG=clinics/riverside.yaml

# ---- LangSmith tracing (voice recordings + tool calls) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dental-receptionist

# ---- Twilio (add once you buy a number; NOT needed for the local browser test) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# PUBLIC_BASE_URL=          # public https URL Twilio calls (ngrok / heroku)
